{
  "name": "auckland-accounting-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/callWorker.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "preflight:live": "tsx scripts/productionPreflight.ts",
    "test:live-call": "tsx scripts/testLiveCall.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
    "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.12",
    "multer": "^2.3.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "prisma": "^6.4.1",
