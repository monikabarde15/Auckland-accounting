# ==============================================================================
# ACULA (Auckland Accounting Services Ltd) — Production Environment Configuration
# ==============================================================================
# Security Notice:
# 1. Never commit real production secrets, passwords, or Twilio tokens to Git.
# 2. In production, JWT_SECRET and JWT_REFRESH_SECRET must be at least 32 random characters.
# 3. ENABLE_LIVE_CALLING defaults to false for telephony safety.
# ==============================================================================

# Core Application
NODE_ENV=production
PORT=5000
BASE_URL=https://acula.aucklandaccounting.co.nz
CORS_ORIGIN=https://acula.aucklandaccounting.co.nz
LOG_LEVEL=info

# PostgreSQL Database (Production Connection Pool)
DATABASE_URL=postgresql://acula_prod_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/auckland_accounting_db?schema=public&sslmode=prefer&connection_limit=25

# Redis Queue & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_AUTH_PASSWORD

# Cryptographic Authentication Secrets (Minimum 32 random characters)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_CRYPTO_SECURE_32_CHAR_JWT_SECRET_KEY
JWT_REFRESH_SECRET=REPLACE_WITH_CRYPTO_SECURE_32_CHAR_REFRESH_SECRET_KEY

# Outbound Worker Concurrency (Max simultaneous active calls across workers)
CALL_WORKER_CONCURRENCY=5

# Live Telephony Safety Gate (Keep false until all production gates pass)
ENABLE_LIVE_CALLING=false

# Twilio Telephony Credentials (Required only when ENABLE_LIVE_CALLING=true)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+6498370000
TWILIO_WEBHOOK_BASE_URL=https://acula.aucklandaccounting.co.nz
