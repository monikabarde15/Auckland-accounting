# Acula Automated Outbound Calling & IVR Platform - Master Environment Template
# Refer to docs/LOCAL-DEVELOPMENT.md for setup instructions.

# Server Configuration
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000
LOG_LEVEL=info

# PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/auckland_accounting_db?schema=public"

# Redis Cache & Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=""

# JWT Security
JWT_SECRET=replace_with_secure_random_string_in_production
JWT_REFRESH_SECRET=replace_with_secure_random_string_in_production

# Twilio Voice API (Phase 5)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
